# ============================================================
# FileForge — local configuration
# ============================================================
# IMPORTANT:
# 1. Copy this file to .env before running the project.
# 2. Replace every CHANGE_ME / empty value that you actually need.
# 3. NEVER commit the real .env to GitHub. The repository ignores it.
# 4. The comments below are a setup guide. After configuring the
#    real .env, DELETE these instructions/comments from .env.
#    Keep this .env.example file in the repository as documentation.
#
# Never send API keys, passwords or secret tokens to the developer/chat.
# Put them directly into your local/server .env.

# -------------------- Application -------------------------------

# Secret used to sign login/session cookies.
# Generate a strong random value. Easy option:
#   Python: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Then paste the generated value after SECRET_KEY=.
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET

# SQLite database location inside the Docker container.
# Usually leave this unchanged.
DATABASE=/data/fileforge.db

# Daily operation limits.
ANON_DAILY_LIMIT=5
USER_DAILY_LIMIT=20
PREMIUM_DAILY_LIMIT=200

# Maximum uploaded file size in megabytes.
MAX_UPLOAD_MB=50

# Current Premium price in RUB.
PREMIUM_PRICE_RUB=999

# Set true only when the site is served through HTTPS.
# For local http://localhost:8000 development keep false.
COOKIE_SECURE=false


# -------------------- AI upscale ---------------------------------

# Optional external AI-upscale adapter.
# If the project is configured to use one, obtain its API endpoint
# and server-side API token from that provider's developer dashboard.
# Put the endpoint into AI_UPSCALE_URL and the secret token into
# AI_UPSCALE_TOKEN.
#
# Do NOT put these values into app/static/ or JavaScript.
AI_UPSCALE_URL=
AI_UPSCALE_TOKEN=


# -------------------- Photo animation ----------------------------

# Photo animation uses the built-in Seedance 2.0 adapter below.
# The old generic ANIMATION_API_* variables are kept only for compatibility
# with older deployments and are no longer used by the Seedance feature.
#
# fal.ai key instructions:
#   1. Create/sign in to a fal.ai account.
#   2. Open the fal developer dashboard.
#   3. Open API Keys / Keys.
#   4. Create a new API key and copy it immediately.
#   5. Keep the key server-side only.
#   6. When the Seedance/fal adapter is enabled, put that key into
#      the variable documented by that adapter (FAL_KEY).
#
# Do not send the key to anyone in chat.
ANIMATION_API_URL=
ANIMATION_API_TOKEN=

# Seedance 2.0 is now the built-in photo-animation provider.
# Get the server-side key from the fal.ai developer dashboard:
#   https://fal.ai/dashboard/keys
#
# The application submits Seedance jobs through fal's queue API.
# The browser never receives this key.
FAL_KEY=


# -------------------- Payments -----------------------------------

# Built-in merchant checkout adapter.
# Use YooKassa for the production Premium checkout.
PAYMENT_PROVIDER=yookassa

# YooKassa merchant credentials:
#   1. Create/sign in to the YooKassa merchant cabinet.
#   2. Open Integration → API keys.
#   3. Copy the Shop ID and secret key.
#   4. Put them into the variables below.
#
# PUBLIC_BASE_URL must be the public HTTPS address of this FileForge
# deployment, for example https://fileforge.example.com
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PUBLIC_BASE_URL=https://CHANGE_ME.example

# YooKassa should send payment.succeeded notifications to:
#   https://YOUR-DOMAIN/api/payment/webhook
#
# The backend verifies the payment server-to-server before granting Premium.

# Legacy generic provider variables. Leave empty when PAYMENT_PROVIDER=yookassa.
PAYMENT_API_URL=
PAYMENT_API_TOKEN=
PAYMENT_WEBHOOK_SECRET=

# ============================================================
# FINAL STEP
# ============================================================
# After you have entered the real values:
#   - save the file as .env
#   - make sure .env is NOT tracked by Git
#   - DELETE these instructional comments from the real .env
#   - NEVER upload the real .env to GitHub
#
# Keep .env.example in the repository with empty placeholders.

# AI-video economics
PREMIUM_VIDEO_SECONDS=30
FREE_VIDEO_TRIAL_SECONDS=5

# Email verification via Resend
# The application sends a real confirmation email through Resend when enabled.
EMAIL_VERIFICATION_ENABLED=false
REQUIRE_EMAIL_VERIFICATION=false
# Create a Resend API key with sending access and keep it server-side.
RESEND_API_KEY=
# Sender address configured in Resend. For production, use an address on a verified domain.
RESEND_FROM_EMAIL=
# Verification links use PUBLIC_BASE_URL above.
